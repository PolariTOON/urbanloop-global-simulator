@startuml

class Main
class ConsoleApp
class WebApp
package controler {
	class Simulation
	class Converter
	class Probability
}
package model {
	package entities {
		class Entity
		package nodes {
			class Node
			package networks {
				class Network
				package ways {
					class Way
					class Switch
					class SwitchIn
					class SwitchOut
					class Route
					package tracks {
						class Track
						class Step
						class Sensor
						class Station
						class Shed
						class Section
					}
				}
			}
		}
		package tokens {
			class Token
			class Traveler
			class Pod
		}
	}
	package lines {
		class Line
		class Bridge
		class Loop
	}
}

Main "0"--"1" ConsoleApp
Main "0"--"1" WebApp
ConsoleApp "0"--"1" Simulation
WebApp "0"--"1..*" Simulation
Simulation "0"--"1" Converter
Simulation "0"*--"1" Network
Simulation "0"--"1" Probability
Entity <|-- Node
Entity <|-- Token
Node <|-- Network
Node <|-- Way
Node <|-- Track
Node "0"--"0..*" Pod
Network "0"*--"0..*" Way
Network "0"*--"0..*" Line
Way <|-- Switch
Way <|-- Route
Switch <|-- SwitchIn
Switch <|-- SwitchOut
Switch "2"--"3" Route
SwitchIn "1"--"1" SwitchOut
Route "0"*--"0..*" Track
Track <|-- Step
Track <|-- Section
Step <|-- Sensor
Step <|-- Station
Step <|-- Shed
Station "0"--"0..*" Traveler
Token <|-- Pod
Token <|-- Traveler
Pod "0"--"0..*" Traveler
Line <|-- Loop
Line <|-- Bridge
Loop "0"--"2..*" Switch
Loop "0"--"2..*" Route
Bridge "0"--"1" Route
Bridge "0"--"2" Switch

@enduml
